//
//                                                        ▀▀▀▀▀     ▀▀▀▀▀          ▀▀█▀▀
//                                                        ▄▀▀▀▄  ▄  ▄▀▀▀▄  ▄  ▄▀▀▀▄  █  ▄▀▀▀▄
//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
//
// Ported from a QMK keymap (LAYOUT_split_3x6_3) that emulated the Totem's 38-key
// layout by blanking the outer-pinky TOP/BOTTOM keys and keeping only the extra
// HOME-row-outer keys (ESC / '). On real Totem hardware the extra key per side
// lives on the BOTTOM row instead (see totem.dtsi matrix transform), so those two
// keys are shifted down onto the bottom-row outer positions here.
//
// Deviation from the QMK source: the MISC layer was entirely unused there (no
// RGB matrix on Totem), so it now holds reset/bootloader/BT controls, which a
// split BLE board needs some way to reach.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define HOME 0
#define NUM  1
#define NAV  2
#define SYM  3
#define FUNC 4
#define MISC 5

&mt {
  quick-tap-ms = <100>;
  global-quick-tap;
  flavor = "tap-preferred";
  tapping-term-ms = <170>;
};

/ {
    combos {
        compatible = "zmk,combos";
        // I+U -> caps word
        combo_caps_word {
            timeout-ms = <50>;
            key-positions = <6 7>;
            bindings = <&caps_word>;
        };
        // M+, -> backspace
        combo_bspc {
            timeout-ms = <50>;
            key-positions = <27 28>;
            bindings = <&kp BSPC>;
        };
        // Vertical (same-column) combos: F+R=( J+U=) G+T={ Y+H=} E+D=[ K+I=]
        combo_lpar {
            timeout-ms = <50>;
            key-positions = <13 3>;
            bindings = <&kp LPAR>;
        };
        combo_rpar {
            timeout-ms = <50>;
            key-positions = <16 6>;
            bindings = <&kp RPAR>;
        };
        combo_lbrc {
            timeout-ms = <50>;
            key-positions = <14 4>;
            bindings = <&kp LBRC>;
        };
        combo_rbrc {
            timeout-ms = <50>;
            key-positions = <5 15>;
            bindings = <&kp RBRC>;
        };
        combo_lbkt {
            timeout-ms = <50>;
            key-positions = <2 12>;
            bindings = <&kp LBKT>;
        };
        combo_rbkt {
            timeout-ms = <50>;
            key-positions = <17 7>;
            bindings = <&kp RBKT>;
        };
        // H+N -> delete
        combo_del {
            timeout-ms = <50>;
            key-positions = <15 26>;
            bindings = <&kp DEL>;
        };
        // D+C -> copy
        combo_copy {
            timeout-ms = <50>;
            key-positions = <12 23>;
            bindings = <&kp LC(C)>;
        };
        // F+V -> paste
        combo_paste {
            timeout-ms = <50>;
            key-positions = <13 24>;
            bindings = <&kp LC(V)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        home_layer {
// HOME: plain QWERTY, mods live on the bottom row (GUI/ALT/SHIFT/CTRL mirrored
// out from center), ESC and ' on the bottom-row outer keys.
label = "HOME";
display-name = "Home";
bindings = <
    &kp Q        &kp W        &kp E        &kp R        &kp T             &kp Y        &kp U        &kp I        &kp O        &kp P
    &kp A        &kp S        &kp D        &kp F        &kp G             &kp H        &kp J        &kp K        &kp L        &kp SEMI
&kp ESC &mt LGUI Z   &mt LALT X   &mt LSFT C   &mt LCTL V   &kp B             &kp N        &mt RCTL M   &mt LSFT COMMA &mt LALT DOT &mt RGUI FSLH &kp SQT
                                  &sk LSHFT    &lt NUM RET  &lt SYM TAB       &mo FUNC     &lt NAV SPACE &sk LSHFT
>;
        };

// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        num_layer {
// NUM: number row on top, shifted symbol directly below each number.
label = "NUM";
display-name = "Num";
bindings = <
    &kp N1       &kp N2       &kp N3       &kp N4       &kp N5            &kp N6       &kp N7       &kp N8       &kp N9       &kp N0
    &kp EXCL     &kp AT       &kp HASH     &kp DLLR     &kp PRCNT         &kp CARET    &kp AMPS     &kp ASTERISK &kp LPAR     &kp RPAR
&trans  &none        &kp GRAVE    &kp TILDE    &kp PLUS     &kp UNDERSCORE    &kp MINUS    &kp EQUAL    &kp LBKT     &kp RBKT     &kp PIPE      &kp BSLH
                                  &kp ESC      &lt NUM RET  &lt SYM TAB       &mo FUNC     &trans       &lt MISC DEL
>;
        };

// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        nav_layer {
label = "NAV";
display-name = "Nav";
bindings = <
    &none        &none        &none        &none        &none             &kp HOME     &none        &none        &kp END      &none
    &kp LGUI     &kp LALT     &kp LCTRL    &kp LSHFT    &none             &kp LEFT     &kp DOWN     &kp UP       &kp RIGHT    &none
&trans  &none        &none        &none        &none        &none             &none        &none        &none        &none        &none         &none
                                  &kp ESC      &trans       &lt SYM TAB       &mo FUNC     &lt NAV SPACE &lt MISC DEL
>;
        };

// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        sym_layer {
// SYM: shifted mirror of NUM, everything sits above its NUM-layer counterpart.
label = "SYM";
display-name = "Sym";
bindings = <
    &kp EXCL     &kp AT       &kp HASH     &kp DLLR     &kp PRCNT         &kp CARET    &kp AMPS     &kp ASTERISK &kp LPAR     &kp RPAR
    &none        &none        &none        &none        &none             &none        &kp UNDERSCORE &kp PLUS   &kp LBRC     &kp RBRC
&trans  &none        &none        &none        &none        &none             &none        &none        &none        &none        &none         &kp PIPE
                                  &kp ESC      &lt NUM RET  &trans            &mo FUNC     &lt NAV SPACE &lt MISC DEL
>;
        };

// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        func_layer {
label = "FUNC";
display-name = "Func";
bindings = <
    &kp F1       &kp F2       &kp F3       &kp F4       &kp F5            &kp F6       &kp F7       &kp F8       &kp F9       &kp F10
    &none        &none        &none        &kp F11      &kp F12           &none        &none        &none        &none        &none
&none   &none        &none        &none        &none        &none             &none        &none        &none        &none        &none         &none
                                  &kp ESC      &lt NUM RET  &lt SYM TAB       &trans       &lt NAV SPACE &lt MISC DEL
>;
        };

// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        misc_layer {
// MISC: empty in the QMK source (no RGB matrix on Totem) - repurposed to hold
// reset/bootloader/BT controls, since it's otherwise unused.
label = "MISC";
display-name = "Misc";
bindings = <
    &sys_reset   &bootloader  &bt BT_CLR   &bt BT_PRV   &bt BT_NXT        &out OUT_TOG &none        &none        &none        &none
    &none        &none        &none        &none        &none             &none        &none        &none        &none        &none
&trans  &none        &none        &none        &none        &none             &none        &none        &none        &none        &none         &none
                                  &trans       &trans       &trans            &trans       &trans       &none
>;
        };
    };
};
